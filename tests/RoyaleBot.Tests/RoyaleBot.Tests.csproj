<Project Sdk="Microsoft.NET.Sdk">

  <!-- Тесты без внешних пакетов: консольное приложение с минимальным раннером в MiniTest.cs.
       Запуск: dotnet run - -project tests/RoyaleBot.Tests [фильтр по имени] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Royale.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/RoyaleBot/RoyaleBot.csproj" />
  </ItemGroup>

</Project>
